# Normalise to LF in the repo and working tree, so Windows and Linux CI agree
* text=auto eol=lf

# Windows-only scripts need CRLF to run correctly
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.jar binary
*.so binary
*.dylib binary
*.a binary
