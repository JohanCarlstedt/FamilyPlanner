<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget: today's next few things, written by the app.
     It renders text the app has already decrypted; nothing here can read
     the family's data by itself. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/today_widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#1B1C18"
        android:text="@string/app_name" />

    <TextView
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:textSize="14sp"
        android:maxLines="5"
        android:ellipsize="end"
        android:textColor="#1B1C18" />
</LinearLayout>
