# TLS and nothing else: Caddy gets the certificate, renews it, and hands
# every request to the API. There is no static content to serve.
{
	# Let's Encrypt issues without a contact address, and Caddy renews on its
	# own, so none is set. Put yours here to be told when a renewal fails:
	#   email you@example.se
}

{$DOMAIN} {
	encode zstd gzip

	# A blob is capped at 4 MB by the API (BlobEndpoints.MaxBlobBytes); this
	# leaves room for the request around one and refuses anything absurd
	# before it reaches the application.
	request_body {
		max_size 8MB
	}

	# The privacy policy, which Google Play requires a public URL for before
	# an app may be released on any track. A static file rather than a route
	# in the API: it is the one page here that has to be readable by someone
	# who is not a family member.
	handle /privacy {
		root * /srv
		rewrite * /privacy.html
		file_server
	}

	handle {
		# Sync waits for changes with a long poll, so the proxy must not give
		# up before the application does.
		reverse_proxy api:8080 {
			transport http {
				read_timeout 120s
			}
		}
	}

	log {
		# Paths and device ids, never content — the server cannot read any.
		# Still worth keeping short: it is a record of who was awake when.
		output file /data/access.log {
			roll_size 10MB
			roll_keep 3
		}
	}
}
