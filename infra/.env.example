# Copy to .env on the server and fill in. Never committed: the database
# password is the one thing here that matters.
#
#   cp .env.example .env && nano .env

# The hostname the phones talk to. Its A/AAAA record must already point at
# this machine, or Let's Encrypt cannot issue the certificate.
DOMAIN=family.example.se

# Generate one and keep it nowhere but this file and your password manager:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# The user the API runs as. It must be the one owning infra/secrets, or the
# push key is unreadable and wakes are only logged. 1000 unless you made
# more than one account on this machine.
# APP_UID=1000
# APP_GID=1000

# What the billing provider must send in its Authorization header for the
# server to believe an entitlement change (docs/going-public.md). Generate
# one and paste the same value into the provider's webhook settings:
#   openssl rand -base64 32
# Leave empty until there is billing: the endpoint then refuses everything.
BILLING_WEBHOOK_TOKEN=

# Optional, both have defaults:
# POSTGRES_DB=family
# POSTGRES_USER=family
# BACKUP_KEEP_DAYS=14
