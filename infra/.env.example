# Copy to .env on the server and fill in. Never committed: the database
# password is the one thing here that matters.
#
#   cp .env.example .env && nano .env

# The hostname the phones talk to. Its A/AAAA record must already point at
# this machine, or Let's Encrypt cannot issue the certificate.
DOMAIN=family.example.se

# Generate one and keep it nowhere but this file and your password manager:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional, both have defaults:
# POSTGRES_DB=family
# POSTGRES_USER=family
# BACKUP_KEEP_DAYS=14
